{
  "expo": {
    "name": "Roshd",
    "slug": "markaz-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/roshd-logo.png",
    "userInterfaceStyle": "light",
    "scheme": "markaz",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ir.markaz.mobile",
      "buildNumber": "2"
    },
    "android": {
      "package": "ir.markaz.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#57a332",
        "foregroundImage": "./assets/roshd-logo.png"
      },
      "predictiveBackGestureEnabled": true,
      "edgeToEdgeEnabled": true,
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/roshd-logo.png"
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}